<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:layoutDirection="rtl">

    <ScrollView android:id="@+id/loginPanel"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:fillViewport="true">
        <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:padding="@dimen/pad">
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:orientation="vertical">
                <TextView android:text="@string/login_title"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center" android:textStyle="bold"
                    android:textSize="@dimen/text_title" android:paddingBottom="@dimen/pad"/>
                <EditText android:id="@+id/etUser" android:hint="@string/username"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="text" android:layoutDirection="ltr"
                    android:textSize="@dimen/text_normal"/>
                <EditText android:id="@+id/etPass" android:hint="@string/password"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:inputType="textPassword" android:layoutDirection="ltr"
                    android:textSize="@dimen/text_normal"/>
                <CheckBox android:id="@+id/cbSave" android:text="@string/save_cred"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:checked="true" android:textSize="@dimen/text_normal"/>
                <Button android:id="@+id/btnLogin" android:text="@string/login"
                    android:layout_width="match_parent" android:layout_height="@dimen/bar_height"
                    android:layout_marginTop="@dimen/pad" android:textColor="#FFFFFF"
                    android:background="@drawable/btn" android:textSize="@dimen/text_normal"/>
                <TextView android:id="@+id/tvStatus"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center" android:paddingTop="@dimen/pad"
                    android:textSize="@dimen/text_normal"/>
                <Button android:id="@+id/btnSettings" android:text="@string/conn_settings"
                    android:layout_width="match_parent" android:layout_height="@dimen/bar_height"
                    android:layout_marginTop="@dimen/pad" android:background="@null"
                    android:textColor="#1565C0" android:textSize="@dimen/text_normal"/>
                <LinearLayout android:id="@+id/settingsBox"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:visibility="gone">
                    <EditText android:id="@+id/etHost" android:hint="@string/proxy_host"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="textUri" android:layoutDirection="ltr"
                        android:textSize="@dimen/text_normal"/>
                    <EditText android:id="@+id/etPort" android:hint="@string/proxy_port"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="number" android:layoutDirection="ltr"
                        android:textSize="@dimen/text_normal"/>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </ScrollView>

    <LinearLayout android:id="@+id/browserPanel"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent"
            android:layout_height="@dimen/bar_height" android:background="#ECEFF1"
            android:orientation="horizontal" android:layoutDirection="ltr">
            <Button android:id="@+id/btnBack" android:text="◀"
                android:layout_width="wrap_content" android:layout_height="match_parent"
                android:minWidth="0dp" android:background="@null"/>
            <Button android:id="@+id/btnFwd" android:text="▶"
                android:layout_width="wrap_content" android:layout_height="match_parent"
                android:minWidth="0dp" android:background="@null"/>
            <Button android:id="@+id/btnReload" android:text="⟳"
                android:layout_width="wrap_content" android:layout_height="match_parent"
                android:minWidth="0dp" android:background="@null"/>
            <EditText android:id="@+id/etUrl"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="match_parent" android:singleLine="true"
                android:inputType="textUri" android:imeOptions="actionGo"
                android:textSize="14sp" android:layoutDirection="ltr"/>
            <Button android:id="@+id/btnLogout" android:text="@string/logout"
                android:layout_width="wrap_content" android:layout_height="match_parent"
                android:minWidth="0dp" android:background="@null" android:textColor="#C62828"
                android:textSize="@dimen/text_normal"/>
        </LinearLayout>
        <HorizontalScrollView android:layout_width="match_parent"
            android:layout_height="@dimen/bar_height" android:background="#CFD8DC"
            android:scrollbars="none">
            <LinearLayout android:id="@+id/siteBar"
                android:layout_width="wrap_content" android:layout_height="match_parent"
                android:orientation="horizontal"/>
        </HorizontalScrollView>
        <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="3dp" android:visibility="gone"/>
        <WebView android:id="@+id/web"
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
    </LinearLayout>
</FrameLayout>
